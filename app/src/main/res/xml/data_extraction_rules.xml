<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12 o superior. Ni el respaldo en la nube ni la transferencia a otro teléfono
   copian la base (usuarios con el hash del PIN y muestras), las fotos ni las preferencias.
   Los datos de la empresa quedan solo en este dispositivo.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
